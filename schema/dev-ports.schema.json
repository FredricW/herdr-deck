{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FredricW/herdr-deck/main/schema/dev-ports.schema.json",
  "title": "Dev manifest port store, version 1 ($XDG_STATE_HOME/dev-manifest/ports.json)",
  "description": "Ports handed out per worktree, shared by every tool that reads dev manifests. Specification: docs/dev-manifest.md, section 10, in github.com/FredricW/herdr-deck.",
  "type": "object",
  "required": ["version", "worktrees"],
  "properties": {
    "version": { "const": 1 },
    "worktrees": {
      "description": "Keyed by the worktree's absolute path, symlinks resolved.",
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^/" },
      "additionalProperties": {
        "type": "object",
        "required": ["ports"],
        "properties": {
          "repo": { "description": "The worktree's main checkout.", "type": "string", "pattern": "^/" },
          "ports": {
            "type": "object",
            "propertyNames": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
            "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 65535 }
          },
          "updated": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
