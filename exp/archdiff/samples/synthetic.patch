+package diff
+
+import (
+	"database/sql"
+	"net/http"
+	"os"
+
+	"github.com/FredricW/herdr-deck/internal/ui"
+)
+
+const tokenEnv = "ABC_EXPORT_TOKEN"
+
+// Export is a made-up example of a change that bends the layering.
+func Export(db *sql.DB) error {
+	_ = ui.Options{}
+	if os.Getenv(tokenEnv) == "" {
+		return nil
+	}
+	if _, err := db.Exec("INSERT INTO export_jobs (id) VALUES (?)", 1); err != nil {
+		return err
+	}
+	_, err := http.Get("https://s3.example.com/bucket")
+	return err
+}
